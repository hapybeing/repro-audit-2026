-# Simulate data with the observed effect size for the out-group condition
-simulate_data_coefs <- function(group_size) {
-  n                <- group_size * 5
-  treatment_levels <- c("control","danger_contr","win_govt",
-                        "win_mainstream","win_parl")
-  treatment        <- factor(rep(treatment_levels, each = group_size),
-                             levels = treatment_levels)
-  swd_ch           <- rnorm(n, mean = 0, sd = sd_residual)
-  swd_ch[treatment == "win_mainstream"] <- rnorm(
-    sum(treatment == "win_mainstream"),
-    mean = effect_size_mainstream, sd = sd_residual
-  )
-  model_sim   <- lm(swd_ch ~ treatment, data = data.frame(swd_ch, treatment))
-  coefs       <- summary(model_sim)$coefficients
-  list(
-    model_sim   = model_sim,
-    coefs_df    = data.frame(
-      term      = rownames(coefs),
-      estimate  = coefs[, "Estimate"],
-      std.error = coefs[, "Std. Error"]
-    )
-  )
-}
