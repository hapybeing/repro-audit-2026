+# =============================================================================
+# FIGURE D11
+# Descriptive trajectories of SWD and LREM feelings by wave,
+# treatment condition, and voter block.
+# =============================================================================
+
+treatment_labels_d11 <- c(
+  "control"        = "Control",
+  "danger_contr"   = "Placebo\nSocial Norm",
+  "win_parl"       = "In-group\nParliament",
+  "win_govt"       = "In-group\nGovernment",
+  "win_mainstream" = "Out-group\nGovernment"
+)
+block_labels_d11 <- c("EZ" = "Zemmour voters",
+                      "MLP" = "Le Pen voters",
+                      "Others" = "Other voters")
+
+desc_data <- fr_exp |>
+  filter(!is.na(treatment)) |>
+  mutate(
+    treatment = recode(treatment, !!!treatment_labels_d11),
+    block     = recode(block, !!!block_labels_d11),
+    block     = factor(block, levels = c("Zemmour voters",
+                                         "Le Pen voters", "Other voters"))
+  ) |>
+  dplyr::select(treatment, block, swd_w1, swd_w2, affect_LREM_w1, affect_LREM_w2) |>
+  pivot_longer(cols      = c(swd_w1, swd_w2, affect_LREM_w1, affect_LREM_w2),
+               names_to  = "variable", values_to = "value") |>
+  mutate(
+    wave = if_else(str_ends(variable, "w1"),
+                   "Wave 1\n(pre-experiment)", "Wave 2\n(post-experiment)"),
+    dv   = if_else(str_starts(variable, "swd"), "SWD", "Feelings toward LREM")
+  ) |>
+  group_by(treatment, block, wave, dv) |>
+  summarise(mean = mean(value, na.rm = TRUE),
+            se   = sd(value, na.rm = TRUE) / sqrt(sum(!is.na(value))),
+            .groups = "drop") |>
+  mutate(wave = factor(wave, levels = c("Wave 1\n(pre-experiment)",
+                                        "Wave 2\n(post-experiment)")))
+
+desc_avg <- desc_data |>
