+# Standard 4-model coef plot (all specifications overlaid)
+make_coef_plot <- function(df, coef_names, y_range, y_label, title) {
+  df |>
+    filter(grepl("^treatment", term)) |>
+    mutate(term = recode(term, !!!coef_names)) |>
+    ggplot(aes(x = term, y = estimate, color = model)) +
+    geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
+    geom_linerange(aes(ymin = lower_ci_95, ymax = upper_ci_95),
+                   position = position_dodge(width = dodge_width),
+                   linewidth = 1) +
+    geom_linerange(aes(ymin = lower_ci_90, ymax = upper_ci_90),
+                   position = position_dodge(width = dodge_width),
+                   linewidth = 1.4) +
+    geom_point(size = 3, position = position_dodge(width = dodge_width)) +
+    scale_color_manual(
+      values = c("grey70", "grey50", "grey30", "black"),
+      name   = "Model"
+    ) +
+    ylim(y_range[1], y_range[2]) +
+    coord_flip() +
+    labs(title = title, x = "", y = y_label) +
+    theme_coef
+}
