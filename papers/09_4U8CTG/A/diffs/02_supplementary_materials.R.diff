+# =============================================================================
+# FIGURE D6 — Post-experimental power simulation and simulated vs. real ATE
+# Runs 500 simulations per group size (n=20 to 250) to estimate power for
+# the out-group win treatment. Also plots ATE from simulated (n=300) vs.
+# real data (n=123) side by side.
+# =============================================================================
+
+effect_size_mainstream <- -1.2660  # observed ATE for out-group win condition
+sd_residual            <- 2.219    # residual SD from baseline model
+n_simulations          <- 500
+group_sizes            <- seq(20, 250, by = 10)
+set.seed(123)
+
+# --- Power simulation --------------------------------------------------------
+
+simulate_power <- function(group_size) {
+  n          <- group_size * 5
+  trt_levels <- c("control", "danger_contr", "win_govt",
+                  "win_mainstream", "win_parl")
+  treatment  <- factor(rep(trt_levels, each = group_size), levels = trt_levels)
+  swd_ch     <- rnorm(n, mean = 0, sd = sd_residual)
+  swd_ch[treatment == "win_mainstream"] <- rnorm(
+    sum(treatment == "win_mainstream"),
+    mean = effect_size_mainstream, sd = sd_residual
+  )
+  model  <- lm(swd_ch ~ treatment, data = data.frame(swd_ch, treatment))
+  pval   <- summary(model)$coefficients["treatmentwin_mainstream", "Pr(>|t|)"]
+  pval < 0.05
+}
+
+power_results <- map_dfr(group_sizes, function(gs) {
+  hits <- replicate(n_simulations, simulate_power(gs))
+  ci   <- binom.confint(sum(hits, na.rm = TRUE), n_simulations,
+                        conf.level = 0.95, methods = "wilson")
+  tibble(group_size = gs,
+         power      = mean(hits, na.rm = TRUE),
+         lower_ci   = ci$lower,
+         upper_ci   = ci$upper)
+})
+
+min_size_80 <- min(power_results$group_size[power_results$power >= 0.80])
+
+plot_power <- ggplot(power_results, aes(x = group_size, y = power)) +
+  geom_ribbon(aes(ymin = lower_ci, ymax = upper_ci), alpha = 0.2) +
+  geom_line(color = "black") +
+  geom_hline(yintercept = 0.80, linetype = "dashed", color = "red") +
+  geom_vline(xintercept = min_size_80, linetype = "dashed", color = "grey50") +
+  annotate("text", x = min_size_80 - 35, y = 0.80,
+           label = paste("Min. group\nsize =", min_size_80),
+           vjust = -1, hjust = 0, size = 3.5) +
+  labs(title = "Power Analysis for Out-group Win Treatment",
+       x = "Group Size", y = "Estimated Power") +
+  theme_minimal() +
+  theme(plot.title = element_text(hjust = 0.5))
+
+# --- Simulated coefficient plot (n = 300) ------------------------------------
+
+sim_coefs <- simulate_data_coefs(60)   # group_size = 60 -> n = 300 total
+
+coef_names_sim <- c(
