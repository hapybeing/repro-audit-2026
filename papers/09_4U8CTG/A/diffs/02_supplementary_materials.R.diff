+# =============================================================================
+# 02_supplementary_materials.R
+# "Blinded by Out-group Hatred: Why Does Radical Party Entry Fail to
+#  Boost Its Voters' Satisfaction with Democracy?"
+#
+# Replication script for all figures and tables in the supplementary materials.
+# Manuscript figures and tables are produced by 01_manuscript.R.
+#
+# Figures produced (saved to figures_supplementary_materials/):
+#   Figure A1  - Facebook ads [static images, stored in facebook_ads/]
+#   Figure B1  - Like-dislike distributions across all three blocks
+#   Figure B2  - Distribution of electoral expectations
+#   Figure D1  - Treatment distribution across blocks
+#   Figure D2  - Covariate balance plots
+#   Figure D3  - ATE on winner perceptions (manipulation check)
+#   Figure D4  - Comprehension check distribution
+#   Figure D5  - ATE on SWD/LREM: all model specifications
+#   Figure D6  - Post-experimental power simulation and simulated vs. real ATE
+#   Figure D7  - Simulated vs. real-data ATE comparison
+#   Figure D8  - Electoral uncertainty bar plots
+#   Figure D9  - ATE on SWD: Le Pen and Others blocks
+#   Figure D10 - Perceptions of electoral winners among Zemmour voters
+#   Figure D11 - Descriptive trajectories of SWD and LREM feelings
+#   Figure E1  - Pilot study ATE on SWD
+#   Figure F1  - FES affect distribution by top 4 candidates
+#
+# Tables produced (saved to tables_supplementary_materials/):
+#   Table A1   - Summary of hypotheses
+#   Table A2   - Micro-targeting strategy
+#   Table A3   - Experimental sample descriptive statistics
+#   Table A4   - Vignettes all blocks (English)
+#   Table A5   - Vignettes all blocks (French)
+#   Table A6   - 2022 French presidential election results
+#   Table B1   - Descriptive statistics: Zemmour block
+#   Table B2   - Descriptive statistics: Le Pen block
+#   Table B3   - Descriptive statistics: Others block
+#   Table B4   - Descriptive statistics: FES Zemmour supporters
+#   Table C1   - Qualitative codebook schema and results
+#   Table C2   - Inter-coder reliability
+#   Table D1   - ATE on winner perceptions: Zemmour
+#   Table D2   - ATE on winner perceptions: Macron/Le Pen
+#   Table D3   - OLS specifications: Zemmour block, DV = SWD change
+#   Table D4   - OLS specifications: Zemmour block + expectations, DV = SWD
+#   Table D5   - OLS specifications: Zemmour block, DV = LREM affect change
+#   Table D6   - OLS specifications: Le Pen block, DV = SWD change
+#   Table D7   - OLS specifications: Others block, DV = SWD change
+#   Table D8   - Multiple hypotheses testing: SWD
+#   Table D9   - Multiple hypotheses testing: LREM affect
+#   Table D10  - Simulated vs. real data regression table
+#   Table E1   - Pilot study OLS specifications
+#   Table F1   - FES vote choice distribution
+#   Table F2   - FES panel OLS: DV = SWD change
+#   Table F3   - FES panel OLS: DV = LREM affect
+#
+# Figure A1 requires no R code. Static images are in facebook_ads/.
+#
+# Project structure (relative to _replication_files.Rproj):
+#   data/                            <- CSV datasets
+#   facebook_ads/                    <- Figure A1 static images
+#   figures_manuscript/              <- output for 01_manuscript.R
+#   figures_supplementary_materials/ <- figure output (created automatically)
+#   tables_manuscript/               <- output for 01_manuscript.R
+#   tables_supplementary_materials/  <- table output (created automatically)
+#   scripts/                         <- this script
+#
+# To run: open _replication_files.Rproj, then Session -> Restart R -> Source.
+# =============================================================================
+
+
+rm(list = ls())
