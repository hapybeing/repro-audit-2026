-make_mht_table <- function(model, caption, filename) {
-  pvals      <- as.numeric(summary(model)$coefficients[, 4])
-  trt_group  <- c("Intercept", "In-group Government", "In-group Parliament",
-                  "Out-group Government", "Placebo")
-  df <- data.frame(
-    Coefficient          = trt_group,
-    "Original p-values"  = pvals,
-    "Bonferroni"         = p.adjust(pvals, method = "bonferroni"),
-    "Holm"               = p.adjust(pvals, method = "holm"),
-    check.names = FALSE
-  )
-  tbl <- kable(df, format = "latex", booktabs = TRUE, escape = FALSE,
-               digits = 2, caption = caption) |>
-    kable_styling(latex_options = "HOLD_position")
-  save_tex(tbl, filename)
-}
