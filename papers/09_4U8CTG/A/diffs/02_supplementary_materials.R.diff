-      str_starts(variable, "3")     ~ "Democratic evaluation",
-      TRUE                          ~ "Other"
-    ),
-    section   = factor(section, levels = c(
-      "Emotions", "Positive evaluations", "Negative evaluations",
-      "Descriptive statements", "Democratic evaluation"
-    )),
-    pct_agree = sprintf("%.0f\\%%", pct_agree * 100),
-    kappa     = if_else(is.na(kappa), "---", sprintf("%.2f", kappa)),
-    alpha     = sprintf("%.2f", alpha)
-  ) |>
-  arrange(section, variable) |>
-  dplyr::select(section, label, n, pct_agree, kappa, alpha)
