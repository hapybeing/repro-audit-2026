-# Build a tidy CI data frame from a model for use in coef plots
-make_coef_df <- function(model, model_label) {
-  broom::tidy(model) |>
-    dplyr::select(term, estimate, std.error) |>
-    mutate(
-      model       = model_label,
-      lower_ci_95 = estimate - std.error * 1.96,
-      upper_ci_95 = estimate + std.error * 1.96,
-      lower_ci_90 = estimate - std.error * 1.645,
-      upper_ci_90 = estimate + std.error * 1.645
-    )
-}
-
-# Combine all four standard model specs into one data frame for a block
-make_combined_df <- function(m1, m2, m3, m4, coef_levels) {
-  bind_rows(
-    make_coef_df(m1, "Non-Robust SE"),
-    make_coef_df(m2, "Robust SE"),
-    make_coef_df(m3, "Non-Robust SE + Controls"),
-    make_coef_df(m4, "Robust SE + Controls")
-  ) |>
-    mutate(
-      term  = factor(term,  levels = coef_levels),
-      model = factor(model, levels = c("Robust SE + Controls",
-                                       "Robust SE",
-                                       "Non-Robust SE + Controls",
-                                       "Non-Robust SE"))
-    )
-}
