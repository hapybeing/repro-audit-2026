+# -----------------------------------------------------------------------------
+# 0a. Packages
+# -----------------------------------------------------------------------------
+
+pkgs <- c("tidyverse", "estimatr", "broom", "patchwork", "here",
+          "kableExtra", "texreg", "stargazer", "vtable",
+          "gridExtra", "grid", "jtools", "plotrix", "MASS", "binom", "scales",
+          "tinytex", "pdftools")
+
+install.packages(setdiff(pkgs, rownames(installed.packages())))
+
+library(tidyverse)
+library(estimatr)
