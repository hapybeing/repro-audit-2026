-# Standardise covariates and reshape to long format for plotting
-prep_balance <- function(data) {
-  data |>
-    mutate(
-      age        = as.numeric(age),
-      gender     = as.numeric(gender),
-      educ       = as.numeric(educ),
-      munic_size = as.numeric(munic_size),
-      paris      = as.numeric(paris),
-      income     = as.numeric(income),
-      lr         = as.numeric(lr)
-    ) |>
-    mutate(across(-treatment,
-                  ~ (. - mean(., na.rm = TRUE)) / sd(., na.rm = TRUE))) |>
-    pivot_longer(cols = !treatment,
-                 names_to = "variable", values_to = "value") |>
-    group_by(treatment, variable) |>
-    summarise(
-      mean_val = mean(value, na.rm = TRUE),
-      lci      = mean_val - 1.96 * plotrix::std.error(value, na.rm = TRUE),
-      hci      = mean_val + 1.96 * plotrix::std.error(value, na.rm = TRUE),
-      .groups  = "drop"
-    )
-}
