+library(gridExtra)   # grid.arrange() for multi-panel figures
+library(grid)
+library(jtools)      # plot_summs() for coefficient plots
+library(plotrix)     # std.error() used in covariate balance
+library(MASS)        # mvrnorm() used in power simulation
+library(binom)        # used in power simulation
