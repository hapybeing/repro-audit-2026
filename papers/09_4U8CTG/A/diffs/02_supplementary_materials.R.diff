-  plot_data <- data |>
-    filter(!is.na({{ var }})) |>
-    mutate(response = factor({{ var }}, levels = 1:5, labels = winner_labels)) |>
-    count(response) |>
-    mutate(pct = n / sum(n))
-  ggplot(plot_data, aes(x = response, y = pct)) +
-    geom_vline(xintercept = avg, linetype = "dashed", color = "grey80") +
-    geom_col(fill = "grey40", color = "black") +
-    geom_text(aes(label = scales::percent(pct, accuracy = 1)),
-              vjust = -0.4, size = 3.5) +
-    annotate("text", x = avg + 0.1, y = 0.50,
-             label = paste0("Mean = ", round(avg, 2)),
-             hjust = 0, size = 3.5) +
-    scale_y_continuous(labels = scales::percent_format(accuracy = 1),
-                       limits = c(0, 0.55)) +
-    labs(title = title, x = "", y = "") +
-    theme_minimal() +
-    theme(text = element_text(color = "black"),
-          panel.grid.major.x = element_blank(),
-          panel.grid.minor   = element_blank())
-}
