{"status":"OK","data":{"id":12134911,"identifier":"DVN/SQRZR8","persistentUrl":"https://doi.org/10.7910/DVN/SQRZR8","protocol":"doi","authority":"10.7910","separator":"/","publisher":"Harvard Dataverse","publicationDate":"2025-10-28","storageIdentifier":"s3://10.7910/DVN/SQRZR8","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":995,"datasetType":"dataset","locks":[],"latestVersion":{"id":505392,"datasetId":12134911,"datasetPersistentId":"doi:10.7910/DVN/SQRZR8","datasetType":"dataset","storageIdentifier":"s3://10.7910/DVN/SQRZR8","versionNumber":1,"internalVersionNumber":8,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","UNF":"UNF:6:C0+P7/SYdsQKjr3/slxqVw==","lastUpdateTime":"2025-10-28T20:00:30Z","releaseTime":"2025-10-28T20:00:30Z","createTime":"2025-10-07T20:35:29Z","publicationDate":"2025-10-28","citationDate":"2025-10-28","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":995,"license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https://licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Replication Data for: Knowing is Disturbing: Emotions and Public Attitudes Toward Digital Control under Autocracy"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Guo, Danqi"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Freie Universität Berlin"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0002-1504-8029","expandedvalue":{"personName":"Guo, Danqi","@id":"https://orcid.org/0000-0002-1504-8029","scheme":"ORCID","@type":"https://schema.org/Person"}}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Kostka, Genia"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Freie Universität Berlin"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0002-3696-9513","expandedvalue":{"personName":"Kostka, Genia","@id":"https://orcid.org/0000-0002-3696-9513","scheme":"ORCID","@type":"https://schema.org/Person"}}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Guo, Danqi"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Freie Universität Berlin"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"gerina.guo@gmail.com"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Digital technologies have transformed the way governments around the world maintain social and political order. However, the intrusive and often repressive nature of modern political control mechanisms, such as digital surveillance and digital censorship, is largely concealed from the public and becomes “normalized” as a result of state propaganda, particularly in authoritarian regimes. Engaging with political psychology literature on emotion, we examine how citizens respond emotionally to such control when exposed to relevant, revealing information, and how these emotions relate to shifts in attitudes toward authoritarian governments. Using a survey experiment and 50 in-depth interviews conducted in China, we find that exposure to revealing information about digital control slightly amplifies negative emotions, but profoundly reduces positive emotions, and significantly undermines public support for authoritarian digital governance. These effects are more pronounced in the context of digital surveillance than censorship and are most severe when individuals perceive control measures as personally targeted. Our findings underscore the political-psychological consequences of digital control, emphasizing the role of emotions in shaping public responses to digital authoritarianism with new insights into the affective dimensions of digital repression."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-10-07"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"digital authoritarianism, emotion, surveillance, censorship, China"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Guo, Danqi"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-10-07"}]}},"files":[{"label":"append_rep.R","restricted":false,"version":1,"datasetVersionId":505392,"dataFile":{"id":12134912,"persistentId":"","filename":"append_rep.R","contentType":"type/x-r-syntax","friendlyType":"R Syntax","filesize":28763,"storageIdentifier":"s3://dvn-cloud:199c062201c-a8671dbf8f89","rootDataFileId":-1,"md5":"435769ad67dee622b5e1fc0dfa64dce3","checksum":{"type":"MD5","value":"435769ad67dee622b5e1fc0dfa64dce3"},"