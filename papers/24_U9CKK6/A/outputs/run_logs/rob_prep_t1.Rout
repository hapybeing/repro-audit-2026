> 
> centFUN <- function(x) {
+   x - mean(x, na.rm = TRUE)
+ }
> 
> result <- apply(EP_debates[,c(22:24, 27:71, 73:75, 77:107,117:118)], MARGIN = 2, FUN = centFUN)
> result <- as.data.frame(result)
