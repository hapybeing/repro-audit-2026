> check <- start %>% pivot_longer(cols = 2:8, names_to = "Correlation with", 
+     values_to = "Correlation")

> check$term <- factor(check$term, levels = c("LIED", 
+     "RoW", "Polity", "FH", "ARD", "AoW", "CPR"))

> check$`Correlation with` <- factor(check$`Correlation with`, 
+     levels = c("LIED", "RoW", "Polity", "FH", "ARD", "AoW", "CPR"))

> check %>% ggplot(aes(x = year, y = Correlation, color = `Correlation with`, 
+     linetype = `Correlation with`)) + geom_line(linewidth = 1) + 
+     theme_classic() + scale_x_continuous(breaks = seq(1900, 2020, 
+     15)) + geom_hline(yintercept = 0) + facet_grid(vars(term), 
+     ) + theme(text = element_text(size = 20)) + theme(legend.position = "bottom") + 
+     xlab("") + ylab("Pearson's r") + scale_y_continuous(breaks = c(0, 
+     0.5, 1), limits = c(-0.15, 1)) + scale_color_grey()

