{"status":"OK","data":{"id":10692908,"identifier":"DVN/VSV5DM","persistentUrl":"https://doi.org/10.7910/DVN/VSV5DM","protocol":"doi","authority":"10.7910","separator":"/","publisher":"Harvard Dataverse","publicationDate":"2024-11-06","storageIdentifier":"s3://10.7910/DVN/VSV5DM","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":995,"datasetType":"dataset","locks":[],"latestVersion":{"id":431053,"datasetId":10692908,"datasetPersistentId":"doi:10.7910/DVN/VSV5DM","datasetType":"dataset","storageIdentifier":"s3://10.7910/DVN/VSV5DM","versionNumber":1,"internalVersionNumber":5,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","deaccessionLink":"","lastUpdateTime":"2024-11-06T17:10:10Z","releaseTime":"2024-11-06T17:10:10Z","createTime":"2024-11-05T20:50:12Z","publicationDate":"2024-11-06","citationDate":"2024-11-06","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":995,"license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https://licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Replication Data for: Leadership in a Pandemic:  State Legislator Constituent Outreach in Response to COVID-19"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Strawbridge, Michael"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Washington University in St. Louis"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Natalie Masuoka"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of California, Los Angeles"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Nadia Brown"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Georgetown University"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Erik Hanson"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Southern California"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Strawbridge, Michael"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Washington University in St. Louis"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"strawbridge@wustl.edu"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This study builds on the existing literature by considering the extent to which minority legislators offer different forms of constituency outreach during times of emergency. This case study of state legislator constituent outreach during the COVID-19 pandemic uses an analysis of Facebook posts in 2020 to track how state legislators provided outreach and communicated resources to their constituents during a public health crisis. We ask, in times of emergency, do women and minority legislators offer unique attention towards the needs of those constituencies that they descriptively represent, or do urgent issues push these legislators to focus more broadly on general concerns expressed by their entire district? We argue that legislators’ social media activity during the COVID-19 pandemic offers an important measure of their practice of constituency outreach due to the nation’s reliance on virtual communication during this period. This study finds there to be important variation by partisanship, but within party, we find important differences depending on both the race and gender of the legislator. Democratic women of all races were those legislators most actively providing information and outreach related to COVID-19 to their constituents in 2020."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Political Representation; Political Representation, Race and Ethnic Politics; Facebook"}}]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"primitive","value":"Strawbridge, Michael G., Nadia E. Brown, Erik Hanson, and Natalie Masuoka. “Leadership in a Pandemic: State Legislator Constituent Activities in Response to COVID-19.” Political Research Quarterly."}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Strawbridge, Michael"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2024-11-05"}]}},"files":[{"label":"Multivariate Analysis.Rmd","restricted":false,"version":1,"datasetVersionId":431053,"dataFile":{"id":10692911,"persistentId":"","filename":"Multivariate Analysis.Rmd","contentType":"text/x-r-notebook","friendlyType":"R Notebook","filesize":68539,"storageIdentifier":"s3://dvn-cloud:192fe1753af-b3d0caf4caed","rootDataFileId":-1,"md5":"2309572a0a0dd3ef0395e0525b692ccb","checksum":{"type":"MD5","value":"2309572a0a0dd3ef0395e0525b692ccb"},"tabularData":false,"creationDate":"2024-11-05","publicationDate":"2024-11-06","lastUpdateTime":"20