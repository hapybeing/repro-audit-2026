peName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of California Riverside"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0001-8257-7206","expandedvalue":{"personName":"Merolla, Jennifer","@id":"https://orcid.org/0000-0001-8257-7206","scheme":"ORCID","@type":"https://schema.org/Person"}}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Osorio, Maricruz"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https://ror.org/01px48m89","expandedvalue":{"scheme":"http://www.grid.ac/ontology/","termName":"Bentley University","@type":"https://schema.org/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0001-5165-4416","expandedvalue":{"personName":"Osorio, Maricruz","@id":"https://orcid.org/0000-0001-5165-4416","scheme":"ORCID","@type":"https://schema.org/Person"}}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Lindke, Christian"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https://ror.org/02e3zdp86","expandedvalue":{"scheme":"http://www.grid.ac/ontology/","termName":"Boise State University","@type":"https://schema.org/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0001-9789-2938","expandedvalue":{"personName":"Lindke, Christian","@id":"https://orcid.org/0000-0001-9789-2938","scheme":"ORCID","@type":"https://schema.org/Person"}}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sean Long"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https://ror.org/00ysfqy60","expandedvalue":{"scheme":"http://www.grid.ac/ontology/","termName":"Oregon State University","@type":"https://schema.org/Organization"}}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"DeMora, Stephanie"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stony Brook University"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"Stephanie.DeMora@stonybrook.edu"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The 2016 election serves as an important case study in understanding how gendered political contexts can shape emotional reactions and engagement, particularly among women. Two important features of that election, Trump’s treatment of women and Clinton’s historic run for office, influenced emotional reactions to politics in distinct ways. We used two experimental designs in which participants were randomly assigned to read vignettes about Trump’s treatment of women or Clinton’s historic run for office. Reading about the former led to higher anger, especially among Democratic women and men, while reading about the latter increased enthusiasm among highly educated women. These elevated emotions increased intended future engagement. We conducted a third study in which we induced anger about Trump’s treatment of women and found that it led to greater intended engagement."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"primitive","value":"British Journal of Political Science"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"DeMora, Stephanie"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-10-30"}]}},"files":[{"label":"01- Replication_Text.R","restricted":false,"version":1,"datasetVersionId":558761,"dataFile":{"id":13101004,"persistentId":"","filename":"01- Replication_Text.R","contentType":"type/x-r-syntax","friendlyType":"R Syntax","filesize":19511,"storageIdentifier":"s3://dvn-cloud:19a36b16011-3e0c2bae3c22","rootDataFileId":-1,"md5":"e70017b42ac85fc216d1566ef3166c78","checksum":{"type":"MD5","value":"e70017b42ac85fc216d1566ef3166c78"},"tabularData":false,"creationDate":"2025-10-30","publicationDate":"2025-10-30","lastUpdateTime":"2025-10-30T20:00:32Z","fileAccessRequest":true}},{"label":"02- Replication_Appendix.R","restricted":false,"version":1,"datasetVersionId":558761,"dataFile":{"id":13101005,"persistentId":"","filename":"02- Replication_Appendix.R","contentType":"type/x-r-syntax","friendlyType":"R Syntax","filesize":24868,"storageIdentifier":"s3://dvn-cloud:19a36b16192-b25b6b3ea434","rootDataFileId":-1,"md5":"09fb9e4a3609758f5f9ce19c810ed86c","checksum":{"type":"MD5","value":"09fb9e4a3609758f5f9ce19c810ed86c"},"tabularData":false,"creationDate":"2025-10-30","publicationDate":"2025-10-30","lastUpdateTime":"2025-10-30T20:00:32Z","fileAccessRequest":true}},{"label":"Data.zip","restricted":false,"version":1,"datasetVersionId":558761,"dataFile":{"id":13101006,"persistentId":"","filename":"Data.zip","contentType":"application/zip","friendlyType":"ZIP Archive","filesize":140055,"storageIdentifier":"s3://dvn-