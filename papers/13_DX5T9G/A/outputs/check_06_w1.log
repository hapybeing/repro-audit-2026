## Probit results for Footnote 20; verisimilitude
##########################################################################
mod_UK <- bayesglm(Y_open ~ 1 +I(T_who == "WHO") + I(T_who == "WHO.Ratified") +  log(T_cases) + Authoritarianism + I(Age/100)  + Gender_male + Edu_university + I(I(LR != -99) * LR) + I(LR == -99),
                   data=subset(data, Country == "UK" & T_cases >= 10000 & T_health_cap == "Poor"), family=binomial(link="probit"),
                   w=subset(data, Country == "UK" & T_cases >= 10000 & T_health_cap == "Poor")$w1)

